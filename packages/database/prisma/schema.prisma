generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DiscoveryRun {
  id                String   @id @default(cuid())
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  status            String   @default("RUNNING")
  searchConfig      Json
  jobsDiscovered    Int      @default(0)
  jobsNormalized    Int      @default(0)
  jobsDeduplicated  Int      @default(0)
  jobsEnriched      Int      @default(0)
  error             String?

  jobs              Job[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([startedAt])
}

model Job {
  id                    String   @id @default(cuid())
  discoveryRunId        String?
  discoveryRun          DiscoveryRun? @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)

  source                String
  sourceJobId           String
  sourceUrl             String

  title                 String
  normalizedTitle       String
  company               String
  normalizedCompany     String
  location              String
  remoteType            String?
  employmentType        String?
  salaryText            String?

  postedAt              DateTime
  discoveredAt          DateTime @default(now())
  enrichedAt            DateTime?

  listingUrl            String
  externalApplyUrl      String?
  canonicalApplyUrl     String?
  description           String? @db.Text
  descriptionHash       String?
  descriptionSimplified String? @db.Text

  requisitionId         String?
  atsProvider           String?
  easyApply             Boolean @default(false)
  isOpen                Boolean @default(true)

  deduplicationKey      String?
  isDuplicate           Boolean @default(false)
  duplicateOf           String?

  rawSourceData         Json
  enrichmentData        Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  scoring               JobScoring?
  enrichmentRecord      JobEnrichment?
  eligibility           JobEligibility?
  applications          Application[]

  @@unique([source, sourceJobId])
  @@index([normalizedCompany])
  @@index([normalizedTitle])
  @@index([postedAt])
  @@index([isOpen])
  @@index([atsProvider])
  @@fulltext([title, description])
}

model JobEnrichment {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status            String   @default("PENDING")
  attemptCount      Int      @default(0)
  lastAttemptAt     DateTime?
  completedAt       DateTime?

  roleMatches       Boolean  @default(true)
  companyMatches    Boolean  @default(true)
  fullerDescription String?  @db.Text
  requisitionId     String?
  atsProvider       String?
  applicationRequirements Json?
  detectedPortal    String?

  error             String?
  errorCategory     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([atsProvider])
}

model JobEligibility {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status            String   @default("PENDING")
  passed            Boolean  @default(false)
  evaluatedAt       DateTime?

  tooOld            Boolean  @default(false)
  isClosed          Boolean  @default(false)
  isDuplicateReq    Boolean  @default(false)
  alreadyApplied    Boolean  @default(false)
  requiresEnrollment Boolean  @default(false)
  citizenshipMismatch Boolean  @default(false)
  clearanceRequired Boolean  @default(false)
  locationViolates  Boolean  @default(false)
  employmentTypeMismatch Boolean  @default(false)
  seniorityOutOfRange Boolean  @default(false)
  experienceTooHigh Boolean  @default(false)
  sponsorshipIssue  Boolean  @default(false)
  companyExcluded   Boolean  @default(false)
  keywordExcluded   Boolean  @default(false)

  sponsorshipStatus String   @default("UNKNOWN")
  rejectionReasons  String[]
  rejectionEvidence Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([passed])
}

model JobScoring {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status            String   @default("PENDING")
  scoredAt          DateTime?

  experienceScore   Float    @default(0)
  viabilityScore    Float    @default(0)
  finalScore        Float    @default(0)

  recommendation    String   @default("SKIP")
  matchedEvidence   Json?
  gaps              Json?
  confidence        Float    @default(0)

  coreResponsibility Float   @default(0)
  requiredSkills    Float    @default(0)
  productDomain     Float    @default(0)
  seniorityAlign    Float    @default(0)
  technicalBg       Float    @default(0)
  education         Float    @default(0)
  locationWork      Float    @default(0)

  sponsorshipVia    Float    @default(0)
  freshnessVia      Float    @default(0)
  appAvailability   Float    @default(0)
  locationVia       Float    @default(0)
  compensationVia   Float    @default(0)
  duplicatePenalty  Float    @default(0)
  portalAccess      Float    @default(0)

  error             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([finalScore])
  @@index([recommendation])
}

model Application {
  id                String   @id @default(cuid())
  jobId             String
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)

  company           String
  title             String
  requisitionId     String?

  state             String   @default("DISCOVERED")
  previousStates    String[]

  accountRequired   Boolean  @default(false)
  accountId         String?
  account           Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  atsProvider       String?
  atsSessionToken   String?

  resumeId          String?
  resume            Document? @relation("ApplicationResume", fields: [resumeId], references: [id], onDelete: SetNull)

  coverLetterId     String?
  coverLetter       Document? @relation("ApplicationCoverLetter", fields: [coverLetterId], references: [id], onDelete: SetNull)

  formInspection    Json?
  answers           ApplicationAnswer[]

  interventions     Intervention[]
  validationReview  ApplicationValidation?

  submittedAt       DateTime?
  confirmedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  failureCategory   String?

  dryRun            Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([jobId])
  @@index([state])
  @@index([company])
  @@index([atsProvider])
  @@index([submittedAt])
}

model ApplicationAnswer {
  id                String   @id @default(cuid())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fieldId           String
  fieldLabel        String
  fieldType         String
  answer            String?
  answerSource      String
  confidence        Float?
  requiresReview    Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([applicationId, fieldId])
  @@index([requiresReview])
}

model ApplicationValidation {
  id                String   @id @default(cuid())
  applicationId     String   @unique
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  passed            Boolean  @default(false)
  validatedAt       DateTime?

  checks            Json
  warnings          String[]
  errors            String[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Intervention {
  id                String   @id @default(cuid())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type              String
  status            String   @default("PENDING")
  description       String?  @db.Text
  metadata          Json?

  screenshot        String?
  screenshotPath    String?

  userResponse      String?
  respondedAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([applicationId])
}

model Document {
  id                String   @id @default(cuid())
  type              String
  name              String
  filename          String   @unique
  filePath          String   @unique

  content           String?  @db.Text
  contentHash       String?

  validationReport  Json?

  applicationAsResume Document[]? @relation("ApplicationResume")
  applicationAsCoverLetter Document[]? @relation("ApplicationCoverLetter")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type])
  @@index([filename])
}

model Account {
  id                String   @id @default(cuid())
  employerDomain    String
  atsTenant         String
  atsProvider       String

  email             String
  credentialId      String
  passwordHash      String?

  accountStatus     String   @default("UNKNOWN")
  createdVia        String?
  lastLoginAt       DateTime?
  loginAttempts     Int      @default(0)
  lockedUntil       DateTime?

  applications      Application[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employerDomain, atsTenant, email])
  @@index([atsProvider])
}

model WorkflowEvent {
  id                String   @id @default(cuid())
  eventId           String   @unique @default(cuid())

  workflowId        String
  jobId             String?
  applicationId     String?

  company           String?
  title             String?
  requisitionId     String?

  eventType         String
  previousState     String?
  newState          String?

  metadata          Json?
  errorCategory     String?
  errorMessage      String?

  timestamp         DateTime @default(now())

  createdAt         DateTime @default(now())

  @@index([workflowId])
  @@index([jobId])
  @@index([applicationId])
  @@index([eventType])
  @@index([timestamp])
}

model JobSearchSelection {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               Job

  selected          Boolean  @default(false)
  selectedAt        DateTime?
  reason            String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([selected])
}
