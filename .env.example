# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_copilot
POSTGRES_DB=job_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Apify
APIFY_TOKEN=

# AI Models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-opus-4-8

# Google OAuth (for Gmail verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Credential Storage
CREDENTIAL_PROVIDER=1password
ONEPASSWORD_SERVICE_ACCOUNT_TOKEN=
ENCRYPTION_KEY=

# Application
APP_BASE_URL=http://localhost:3000
TIMEZONE=America/Chicago
NODE_ENV=development
LOG_LEVEL=info

# Playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOWMO=100
PLAYWRIGHT_TIMEOUT=30000

# Browser concurrency
MAX_BROWSER_WORKERS=3
MAX_DISCOVERY_WORKERS=8
MAX_ENRICHMENT_WORKERS=5
MAX_SCORING_WORKERS=10
MAX_DOCUMENT_WORKERS=5

# Application defaults
DEFAULT_SUBMISSION_MODE=manual
DEFAULT_MAX_APPLICATIONS=100
DEFAULT_MINIMUM_SCORE=7.0
