    "@job-copilot/ats-adapters": "workspace:*",
    "@job-copilot/credentials": "workspace:*",
    "@job-copilot/interventions": "workspace:*",
    "@prisma/client": "^5.7.1",
    "bullmq": "^5.4.11",
    "redis": "^4.6.12",
